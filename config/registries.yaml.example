# Copy to /etc/rancher/rke2/registries.yaml only after replacing the example values.
mirrors:
  docker.io:
    endpoint:
      - https://harbor.example.com
  harbor.example.com:
    endpoint:
      - https://harbor.example.com

configs:
  harbor.example.com:
    auth:
      username: REPLACE_WITH_ROBOT_ACCOUNT
      password: REPLACE_WITH_ROBOT_TOKEN
    tls:
      ca_file: /etc/rancher/rke2/harbor-ca.crt
